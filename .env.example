# Every variable jobkit reads, with no values. Where each one goes is set
# out in SPEC-platform.md, B8, and in docs/runbook/setup.md:
#   V = Vercel (Production only)   L = .env.local   O = .env.ops.local

# Owner and app (V, L)
OWNER_EMAIL=
APP_ORIGIN=
JOBKIT_ENV=

# Google sign-in (V, L)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database and storage (V, O)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Database bootstrap, laptop operations only (O)
DATABASE_BOOTSTRAP_URL=
JOBKIT_APP_DB_PASSWORD=

# Model keys for the app (V)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model keys for evaluations, laptop only (L)
ANTHROPIC_EVALS_API_KEY=
GEMINI_EVALS_API_KEY=
JOBKIT_LOCAL_EVALS=

# Cron secrets (V, O)
CRON_SECRET=
KEEPALIVE_SECRET=
